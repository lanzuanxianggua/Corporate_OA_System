<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.oa</groupId>
        <artifactId>oa-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>oa-web</artifactId>
    <name>oa-web</name>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-service</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-platform-core</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-platform-security</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-workflow-api</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-document</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-knowledge</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-meeting</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-task</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-hr</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-admin</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-finance</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-message</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-integration</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Spring AOP for aspects -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <!-- MyBatis-Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>