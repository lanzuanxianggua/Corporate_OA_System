<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.oa</groupId>
        <artifactId>oa-system-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>oa-platform-web</artifactId>
    <name>oa-platform-web</name>
    <description>v2 启动模块 (Phase 2 精简版: 仅 common + security + system)</description>

    <dependencies>
        <!-- 平台层 -->
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-platform-common</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-platform-security</artifactId>
        </dependency>

        <!-- 系统层 (登录/认证/用户) -->
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-system</artifactId>
        </dependency>

        <!-- 流程引擎 (WfInstance/Task/Assignee) -->
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-workflow</artifactId>
        </dependency>

        <!-- HR 业务 (HrLeave 请假申请) -->
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-hr-leave</artifactId>
        </dependency>

        <!-- HR 考勤 -->
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-hr-attendance</artifactId>
        </dependency>

        <!-- HR 员工档案 -->
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-hr-employee</artifactId>
        </dependency>

        <!-- 行政管理 (印章/资产/用品) -->
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-admin</artifactId>
        </dependency>

        <!-- 财务管理 -->
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-finance</artifactId>
        </dependency>

        <!-- 会议管理 -->
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-meeting</artifactId>
        </dependency>

        <!-- 文档管理 -->
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-document</artifactId>
        </dependency>

        <!-- 消息通知 -->
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-message</artifactId>
        </dependency>

        <!-- 知识管理 -->
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-knowledge</artifactId>
        </dependency>

        <!-- 任务管理 -->
        <dependency>
            <groupId>cn.oa</groupId>
            <artifactId>oa-task</artifactId>
        </dependency>

        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 数据库 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- H2 测试数据库 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
        </dependency>
    <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>oa-platform-web</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>cn.oa.platform.web.OaSystemApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
